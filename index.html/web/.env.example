# Supabase (same project as the root static site's coin-core -- see
# ../supabase/. Reuse the existing project ref; this app is a separate
# frontend, not a separate backend.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# U-AI deep-insight provider (web/lib/uai/provider.ts). Priority order:
# ANTHROPIC_API_KEY > OPENAI_API_KEY > OPENROUTER_API_KEY > NVIDIA_NIM_API_KEY
# > BYTEZ_API_KEY -- the first one set wins, so a higher key added later
# switches the engine back with zero code change. The last three are a
# free/low-cost fallback tier (all OpenAI-compatible /chat/completions) that
# keeps the feature live at zero premium spend if neither paid key above is
# provisioned yet. Model ids are optional overrides; defaults:
# claude-sonnet-5 / gpt-4o / meta-llama/llama-3.3-70b-instruct:free /
# meta/llama-3.1-8b-instruct / meta-llama/Llama-3.1-8B-Instruct. Verify the
# free-router model id is still live before relying on it -- free-tier
# catalogs on these three shift over time.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
BYTEZ_API_KEY=
UAI_ANTHROPIC_MODEL=
UAI_OPENAI_MODEL=
UAI_OPENROUTER_MODEL=
UAI_NVIDIA_NIM_MODEL=
UAI_BYTEZ_MODEL=

# U-AI FREE Phase-1 "live web synthesis" (web/lib/uai/webSynthesis.ts).
# "1" or "true" => the free search folds real online references (keyless,
# CORS-only Wikipedia/Wikimedia REST, fetched client-side, cached in
# localStorage) into the 51-doctrine deconstruction. Unset/any other value
# => pure local heuristics, zero external calls. No API key, no server cost.
NEXT_PUBLIC_UAI_WEB_SYNTHESIS=

# 24h sovereign caching engine for the shortcut matrix + knowledge ladder
# (web/lib/uai/shortcutCache.ts, /api/u-ai/shortcut-cache[/refresh]).
# CRON_SECRET: shared secret the Vercel cron (web/vercel.json) sends as
# `Authorization: Bearer ...` to the nightly refresh route; the route refuses
# to run (503) while it is unset. Any long random string.
CRON_SECRET=
# Optional tuning of one batch run: wall-clock budget (ms, default 50000)
# and max LLM deep-report forges per run (default 16, always under the
# global DAILY_REDESIGN_CAP).
SHORTCUT_CRON_BUDGET_MS=
SHORTCUT_CRON_FORGE_BUDGET=

# Sovereign founder auth (web/lib/sovereignAuth.ts, web/middleware.ts,
# /api/sovereign/verify). `?sovereign_auth=<SOVEREIGN_AUTH_TOKEN>` on any
# page mints an HMAC-signed HttpOnly founder session (30 days) and redirects
# with the token stripped; founder-only UI renders only after the server
# verifies that cookie. Both are optional: the token falls back to the
# owner-specified default in lib/sovereignAuth.ts, and the signing secret is
# derived from the token unless set here. Rotating either invalidates every
# outstanding founder session.
SOVEREIGN_AUTH_TOKEN=
SOVEREIGN_AUTH_SIGNING_SECRET=
