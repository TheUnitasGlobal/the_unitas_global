# Supabase (same project as the root static site's coin-core -- see
# ../supabase/. Reuse the existing project ref; this app is a separate
# frontend, not a separate backend.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# U-AI deep-insight provider (web/lib/uai/provider.ts). ANTHROPIC_API_KEY is
# preferred whenever set; OPENAI_API_KEY is the drop-in fallback. Model ids
# are optional overrides (defaults: claude-sonnet-5 / gpt-4o).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
UAI_ANTHROPIC_MODEL=
UAI_OPENAI_MODEL=

# U-AI FREE Phase-1 "live web synthesis" (web/lib/uai/webSynthesis.ts).
# "1" or "true" => the free search folds real online references (keyless,
# CORS-only Wikipedia/Wikimedia REST, fetched client-side, cached in
# localStorage) into the 51-doctrine deconstruction. Unset/any other value
# => pure local heuristics, zero external calls. No API key, no server cost.
NEXT_PUBLIC_UAI_WEB_SYNTHESIS=
