{
  "name": "unitas-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-module-registry.mjs",
    "build": "next build",
    "postbuild": "node scripts/ownership-fingerprint.mjs",
    "build:memcheck": "next build --experimental-debug-memory-usage",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "gen:types": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-types.ps1",
    "gen:coming-soon": "node scripts/generate-coming-soon-cinema.mjs --loop --target=web --optimize=low-memory",
    "i18n:sync": "node --experimental-strip-types scripts/i18n-sync.ts",
    "assets:sync": "node scripts/asset-pipeline-sync.mjs",
    "verify:integrity": "node scripts/verify-integrity.mjs",
    "test": "vitest run",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-all.ps1"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.3",
    "@types/three": "^0.185.4",
    "ai": "^7.0.77",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "glsl-noise": "^0.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "matter-js": "^0.20.0",
    "next": "^14.2.35",
    "next-intl": "^4.13.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
