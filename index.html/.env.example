# Supabase public browser configuration
SUPABASE_URL=https://fjznkonbjoierxvopiko.supabase.co
SUPABASE_ANON_KEY=<paste-the-project-anon-key>
SUPABASE_PROJECT_REF=fjznkonbjoierxvopiko
SUPABASE_ACCESS_TOKEN=<set-locally-or-in-github-actions>

# Supabase Edge Function secrets; never expose these in index.html
STRIPE_SECRET_KEY=sk_test_<set-in-supabase-secrets>
STRIPE_WEBHOOK_SECRET=whsec_<set-in-supabase-secrets>
SITE_URL=https://theunitas.global

# Coin bundle Price IDs (one-time payment mode) -- active coin-core purchase
# catalog. Replace each placeholder with the real Stripe Price ID.
PRICE_ID_COIN_SMALL=price_<10-usd-1000-coins>
PRICE_ID_COIN_MEDIUM=price_<25-usd-2750-coins>
PRICE_ID_COIN_LARGE=price_<50-usd-6000-coins>

# DEPRECATED (Rev 0 coin-core): recurring per-module Price IDs. Module
# access no longer reads these -- retained only because create-checkout-session
# and public.subscriptions are still live/dormant, not actively deleted.
PRICE_ID_ARCHE=price_<arche-recurring-price>
PRICE_ID_ARENA=price_<arena-recurring-price>
PRICE_ID_SCORE=price_<score-recurring-price>
PRICE_ID_FATE=price_<fate-recurring-price>
PRICE_ID_CODEX22=price_<codex22-recurring-price>

# Optional FlutterFlow custom action configuration.
# FlutterFlow has no project-local CLI; use these values in a custom action/API call.
FLUTTERFLOW_API_BASE_URL=https://fjznkonbjoierxvopiko.supabase.co/functions/v1

# AI providers used by Continue, Roo Code, and the CLI review scripts.
# Keep these values in the user environment, VS Code secret storage, or CI secrets.
ANTHROPIC_API_KEY=<set-locally>
OPENAI_API_KEY=<set-locally>
GEMINI_API_KEY=<set-locally>
