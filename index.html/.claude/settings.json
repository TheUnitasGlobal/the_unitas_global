{
  "autoCompactEnabled": true,
  "autoCompactWindow": 70000,
  "precomputeCompactionEnabled": true,
  "autoMemoryEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/index.html/web/scripts/stage3-brief.mjs\" --hook 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Stage-3 자율 브리핑 수집 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel)\" || exit 1; W=\"$R/index.html/web\"; if [ -n \"$(git -C \"$R\" status --porcelain -- index.html/web)\" ]; then npm --prefix \"$W\" run typecheck && npm --prefix \"$W\" run build || exit 1; elif [ -n \"$(git -C \"$R\" status --porcelain)\" ]; then node \"$R/index.html/scripts/sync-codex.mjs\" || exit 1; fi; git -C \"$R\" add -A && git -C \"$R\" commit -m \"feat: automated low-memory sovereign checkpoint sync\" && git -C \"$R\" push origin main && echo \"checkpoint: $(git -C \"$R\" rev-parse --short HEAD) pushed to origin/main\"",
            "timeout": 300,
            "statusMessage": "Sovereign sync: verifying (web/ typecheck+build, else codex drift gate) before checkpoint..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm pkg *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm --prefix web *)",
      "Bash(mkdir *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(pnpm install)",
      "Bash(pnpm run *)",
      "Bash(cd web && npm *)",
      "Bash(tsc *)",
      "Bash(npx tsc *)",
      "Bash(node *)",
      "Bash(npx next *)",
      "Bash(npx playwright *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git checkout -b *)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(git push*)",
      "Bash(vercel --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(npx --no-install vercel --prod*)",
      "Bash(bash scripts/deploy-with-rollback.sh*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(supabase db reset*)",
      "Bash(npm publish*)",
      "Bash(npm deprecate*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(supabase migration *)",
      "Bash(netlify *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ]
  }
}
