{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Unitas: build pages",
      "type": "npm",
      "script": "build:pages",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Unitas: test",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Unitas: setup agents",
      "type": "npm",
      "script": "setup:agents",
      "problemMatcher": []
    },
    {
      "label": "Unitas: mock checkout",
      "type": "npm",
      "script": "mock:checkout",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Unitas: agent review",
      "type": "npm",
      "script": "review:agents",
      "problemMatcher": []
    },
    {
      "label": "Unitas: check AI providers",
      "type": "npm",
      "script": "check:ai",
      "problemMatcher": []
    },
    {
      "label": "Unitas: release",
      "type": "npm",
      "script": "release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dev: Web Next.js",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build: Full Portal",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Git: Sovereign Sync",
      "type": "shell",
      "command": "git add . && git commit -m \"feat: god-tier sovereign omni-ai absolute sync\" && git push origin main",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
